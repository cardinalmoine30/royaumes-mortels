# Dons de la faction Gobelins de la Lune Noire
attribute @s minecraft:scale modifier add royaumes:faction -0.3 add_multiplied_base
attribute @s minecraft:movement_speed modifier add royaumes:faction 0.1 add_multiplied_base
attribute @s minecraft:max_health modifier add royaumes:faction -6 add_value
effect give @s minecraft:night_vision infinite 0 true
effect give @s minecraft:jump_boost infinite 0 true
