# Dons de la faction Nighthaunt
attribute @s minecraft:gravity modifier add royaumes:faction -0.03 add_value
attribute @s minecraft:safe_fall_distance modifier add royaumes:faction 10 add_value
attribute @s minecraft:movement_speed modifier add royaumes:faction 0.05 add_multiplied_base
attribute @s minecraft:max_health modifier add royaumes:faction -4 add_value
effect give @s minecraft:night_vision infinite 0 true
