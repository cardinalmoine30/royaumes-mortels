{"type": "minecraft:confirmation", "title": {"text": "Fils d'Ymorath", "color": "dark_green", "bold": true}, "body": [{"type": "minecraft:plain_message", "width": 300, "contents": [{"text": "Géants colossaux, enfants du dieu-titan Ymorath. Ils écrasent tout sur leur passage.\n\n", "color": "white", "italic": true}, {"text": "Grande Alliance : ", "color": "gray"}, {"text": "Destruction\n", "color": "dark_green"}, {"text": "Royaume d'origine : ", "color": "gray"}, {"text": "Féralia\n\n", "color": "white"}, {"text": "Dons : ", "color": "green", "bold": true}, {"text": "Taille ×2, +10 cœurs, +4 dégâts, grande portée, enjambe les blocs\n", "color": "green"}, {"text": "Faiblesses : ", "color": "red", "bold": true}, {"text": "Faim II permanente, ne passe pas les portes\n\n", "color": "red"}, {"text": "Équipement : ", "color": "gold"}, {"text": "Tronc d'Arbre Arraché (niveau fer), vivres et Pierre de Royaume. Armure : à forger (Forge de guerre).", "color": "yellow"}]}], "can_close_with_escape": false, "yes": {"label": {"text": "Rejoindre", "color": "green", "bold": true}, "width": 120, "action": {"type": "run_command", "command": "trigger rm_choix set 25"}}, "no": {"label": {"text": "← Retour"}, "width": 120, "action": {"type": "show_dialog", "dialog": "royaumes:alliance_destruction"}}}