{
  "type": "minecraft:multi_action",
  "title": {
    "text": "Blocs et ressources des Royaumes",
    "color": "light_purple",
    "bold": true
  },
  "external_title": {
    "text": "Blocs des Royaumes",
    "color": "light_purple"
  },
  "body": [
    {
      "type": "minecraft:plain_message",
      "width": 400,
      "contents": [
        {
          "text": "Où trouver les ressources :\n\n",
          "color": "gray"
        },
        {
          "text": "• Pierre des Royaumes brute",
          "color": "light_purple"
        },
        {
          "text": " — tous les guerriers de faction, améthyste des Royaumes\n",
          "color": "white"
        },
        {
          "text": "• Lingot de Célestacier",
          "color": "gold"
        },
        {
          "text": " — Foudroyés (Célestis) ; ou Forge : or + lapis + éclat\n",
          "color": "white"
        },
        {
          "text": "• Fangepierre",
          "color": "green"
        },
        {
          "text": " — Hommes-Rats ; blocs de fangepierre verts\n",
          "color": "white"
        },
        {
          "text": "• Éclat de Ferrumia",
          "color": "gold"
        },
        {
          "text": " — Tueurs-de-Braise ; minerai d'or des Royaumes\n",
          "color": "white"
        },
        {
          "text": "• Éclat de Ferrumia",
          "color": "yellow"
        },
        {
          "text": " — Nuées ; or brut de Ferrumia\n",
          "color": "white"
        },
        {
          "text": "• Éclat de Nécréa",
          "color": "dark_aqua"
        },
        {
          "text": " — morts-vivants de Nécréa ; blocs d'os de Nécréa\n",
          "color": "white"
        },
        {
          "text": "• Éclat d'Pyréa",
          "color": "red"
        },
        {
          "text": " — Sangrath et Ashkar ; magma d'Pyréa\n",
          "color": "white"
        },
        {
          "text": "• Éclat de Féralia",
          "color": "gold"
        },
        {
          "text": " — Astrosauriens, Ogres, Géants\n",
          "color": "white"
        },
        {
          "text": "• Éclat de Sylvéa",
          "color": "green"
        },
        {
          "text": " — Sylvains, Morbus ; azalées de Sylvéa\n",
          "color": "white"
        },
        {
          "text": "• Éclat d'Umbria",
          "color": "dark_gray"
        },
        {
          "text": " — Filles de Morvaine, Abyssal, Gobelins\n",
          "color": "white"
        },
        {
          "text": "• Éclat d'Lumina",
          "color": "white"
        },
        {
          "text": " — de Lumière ; calcite de Lumina\n",
          "color": "white"
        },
        {
          "text": "• Éclat du Chaos",
          "color": "dark_red"
        },
        {
          "text": " — Guerriers du Chaos ; obsidienne pleureuse\n",
          "color": "white"
        },
        {
          "text": "• Ferraille d'Orc",
          "color": "gray"
        },
        {
          "text": " — Mâchefers et Cruelgars\n",
          "color": "white"
        },
        {
          "text": "• Éclat d'Célestis",
          "color": "aqua"
        },
        {
          "text": " — minerai de lapis des Cimes d'Célestis\n",
          "color": "white"
        }
      ]
    }
  ],
  "can_close_with_escape": true,
  "pause": false,
  "columns": 2,
  "actions": [
    {
      "label": {
        "text": "Forge des Royaumes",
        "color": "gold"
      },
      "width": 150,
      "tooltip": {
        "text": "Ce que l'on fabrique avec ces ressources"
      },
      "action": {
        "type": "run_command",
        "command": "trigger rm_forge"
      }
    },
    {
      "label": {
        "text": "Tout recevoir (créatif)",
        "color": "aqua"
      },
      "width": 150,
      "tooltip": {
        "text": "Réservé aux opérateurs : tonneaux de tous les objets et blocs du mod"
      },
      "action": {
        "type": "run_command",
        "command": "function royaumes:debug/objets"
      }
    }
  ],
  "exit_action": {
    "label": {
      "text": "Fermer"
    },
    "width": 100
  }
}